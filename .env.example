# --- LLM (Groq — fast + free tier, good for testing) ---
GROQ_API_KEY=your_groq_key_here
# openai/gpt-oss-120b is Groq's current recommended model for tool use (Aug 2026).
# Get a free key at https://console.groq.com
GROQ_MODEL=openai/gpt-oss-120b

# --- Speech-to-Text ---
# "local" uses faster-whisper on-device. "deepgram" is a pluggable alternative.
STT_PROVIDER=local
STT_MODEL_SIZE=small
# Only needed if STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# --- Text-to-Speech ---
# "edge" is free/local-network, "elevenlabs" is a pluggable alternative.
TTS_PROVIDER=edge
TTS_VOICE=en-US-GuyNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Wake word ---
WAKE_WORD_MODEL=jarvis
WAKE_WORD_THRESHOLD=0.5

# --- Browser ---
DEFAULT_BROWSER=chrome

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log
